# Template for .env -- copy to .env and fill in. The real .env is gitignored.
#
#   cp .env.example .env
#
# Loaded by code/run_demo.py and code/main.py via python-dotenv. Values already
# present in the environment take precedence, so `export VAR=...` still wins.

# ---------------------------------------------------------------- required ----

# OpenRouter API key, from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Where the Hugging Face assets were downloaded. Must contain database/,
# Final_outline/, Final_outline_First/ and gte-large-en-v1.5/.
#   hf download InternScience/SurveyForge_database --repo-type dataset --local-dir <dir>
#   hf download Alibaba-NLP/gte-large-en-v1.5 --local-dir <dir>/gte-large-en-v1.5
# then unzip Final_outline.zip and Final_outline_First.zip inside <dir>.
SURVEYFORGE_DATA=/path/to/SurveyForge_data

# ------------------------------------------------------- database update ----

# Semantic Scholar key, from https://www.semanticscholar.org/product/api
# Only scripts/fetch_citations.py needs it, to fill citation_count on newly
# harvested papers. The reranker sorts by that field inside each time window,
# so leaving it at 0 would sink every new paper to the bottom of its window.
# Never pass it in argv -- `ps` exposes it to every other user on the box.
SEMANTIC_SCHOLAR_API_KEY=s2k-...

# ---------------------------------------------------------- paper cutoffs ----

# Which papers the pipeline can see. All three default to the values that used to be
# hardcoded in the retrieval path, so leaving them unset reproduces the published run
# exactly -- and, after a database update, silently hides everything newer. main.py
# compares them against the database at startup and warns; the warnings also land in
# code/output/res/<model>/<topic>/exp_<n>/cutoff_report.log
#
# The shipped database runs to arXiv id 2409 and date 2024-09-25, so with the stock
# values below nothing is excluded today.

# Retrieval pool, applied in both the outline and the writing stage. Papers whose
# arXiv id prefix (YYMM) is above this cannot be retrieved or cited. Note the
# sub-outline stage is NOT filtered, so a stale value here lets it propose
# subsections the writer then has no papers for.
SURVEYFORGE_PAPER_ID_CUTOFF=2412

# Citation reranker window. Retrieved papers dated outside [oldest, newest] are
# discarded before ranking and can never be cited. This is a publication date, not an
# id prefix -- arXiv assigns the id's YYMM by announcement month while `date` is the
# submission date, so the two disagree across month boundaries and cannot be
# collapsed into one value.
SURVEYFORGE_PAPER_DATE_OLDEST=2012-01-01
SURVEYFORGE_PAPER_DATE_NEWEST=2024-09-26

# ------------------------------------------------------------------ model ----

# Ids containing "deepseek" take APIModel's OpenAI-SDK branch, where the URL below
# is used as base_url and must NOT include an endpoint path. Other ids take the
# raw-requests branch and need the full .../chat/completions path.
SURVEYFORGE_MODEL=deepseek/deepseek-v4-pro
SURVEYFORGE_API_URL=https://openrouter.ai/api/v1

# Pin the OpenRouter endpoint. Its providers serve different quantizations of the
# same weights (fp4 / fp8 / first-party), so an unpinned run mixes them within one
# survey. Setting this also disables fallbacks. Check the [PROVIDER] log line.
# List slugs with:
#   curl -s https://openrouter.ai/api/v1/models/<model>/endpoints | jq '.data.endpoints[].tag'
SURVEYFORGE_PROVIDER=deepseek

# Or filter by precision instead of naming providers, e.g. fp8
SURVEYFORGE_QUANTIZATIONS=

# Reasoning models: tokens bill as output, come out of MAX_TOKENS, and break the
# outline parser if they leak into `content`.
#   effort: none | low | medium | high | xhigh   (empty = provider default)
SURVEYFORGE_REASONING_EFFORT=
SURVEYFORGE_REASONING_EXCLUDE=

# Truncation guard, not a length control. Omitting it does not mean "no limit":
# unpinned, OpenRouter routes per request and provider caps differ by 64x, so the
# ceiling would vary randomly between calls. With a pinned provider the cap is
# that endpoint's; 32,768 is ~46x what a 500-word subsection needs, so it should
# never bind. Reasoning tokens come out of the same budget -- watch [TRUNCATED].
SURVEYFORGE_MAX_TOKENS=32768

# ------------------------------------------------------------ concurrency ----

# Peak concurrent requests = MAX_SECTION_THREADS * MAX_THREADS.
SURVEYFORGE_MAX_THREADS=8
SURVEYFORGE_MAX_SECTION_THREADS=2

# Repeats per topic; output lands in code/output/res/<model-slug>/<topic>/exp_<n>/
SURVEYFORGE_EXPS=1
