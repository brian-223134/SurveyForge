.venv/
__pycache__/
*.pyc

# Leading slash anchors this to the repo root (main.py's --saving_path defaults to
# ./output/). Unanchored, `output/` matches a directory named output at any depth,
# which swallowed code/output and made the run rules at the bottom unreachable.
/output/

# holds the API key; .env.example is the tracked template
.env

# scratch notes and run logs land as .txt; keep the ones that are real config
*.txt
!code/requirements-fixed.txt
!code/requirement.txt
!code/topics_demo.txt
!SurveyBench/topics.txt

# ----------------------------------------------------------- generated runs ---
# Everything a run writes under code/output/ is tracked, so the survey and the
# intermediate artifacts behind it (outlines, retrieved-doc dumps, citation map,
# timings) are all reviewable on GitHub.
#
# This block must stay LAST. .gitignore is last-match-wins, and the `*.txt` rule
# above would otherwise re-ignore raw_survey.txt, refined_survey.txt and the
# outline dumps -- most of what makes a run reviewable.
!code/output/**

# LaTeX build artifacts from code/tools/md_to_tex.py --compile. The .tex, .bib
# and .pdf are kept; these are regenerated by any pdflatex run. The .log rule has
# to spare the two logs the pipeline itself writes, which share the extension.
code/output/**/*.aux
code/output/**/*.out
code/output/**/*.toc
code/output/**/*.fls
code/output/**/*.fdb_latexmk
code/output/**/*.log
!code/output/**/time_cost.log
!code/output/**/experiment_times.log

# One exception: a 24MB dump of every retrieved abstract, rewritten each run.
# The other 27 files of a run come to 3MB combined, so this single file would be
# 89% of what lands in git -- and it is derived data the pipeline regenerates.
# Delete this line if you do want it committed.
code/output/**/paper_texts.txt

.DS_Store
**/.DS_Store
# 평가용 변환 산출물 (scripts/to_surveybench_ref.py). 저자 배포본
# SurveyBench/generated_surveys_ref/ 와 섞이지 않도록 별도 경로를 쓴다.
SurveyBench/eval_runs/
